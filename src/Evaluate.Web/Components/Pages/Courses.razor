@page "/courses"
@using Evaluate.Application.Courses.Queries.GetCoursesList
@using Evaluate.Application.Courses.Commands.CreateCourse
@using Evaluate.Application.Courses.Commands.UpdateCourse
@using Evaluate.Application.Courses.Commands.ActivateCourse
@using Evaluate.Application.Courses.Commands.DeactivateCourse
@using Evaluate.Application.Topics.Queries.GetTopicsList
@using Evaluate.Application.Topics.Commands.CreateTopic
@using Evaluate.Application.Topics.Commands.UpdateTopic
@using Evaluate.Application.Topics.Commands.DeactivateTopic
@using Evaluate.Application.Common.Exceptions
@using Evaluate.Application.Common.Models
@using MediatR
@inject IMediator Mediator
@inject ToastService Toast
@inject ConfirmService Confirm

<PageTitle>Courses - Evaluate</PageTitle>

<PageHeader Title="Courses" Subtitle="Courses and the topics taught within them."
            AddOptions="_addOptions" OnRefresh="RefreshAsync" />

<Modal IsVisible="_showCourseModal" Title="@(_editingCourseId.HasValue ? "Edit Course" : "Add Course")"
       Subtitle="@(_editingCourseId.HasValue ? "Update this course's details." : "Create a new course students can be evaluated in.")"
       OnClose="() => _showCourseModal = false">
    <div class="form-row">
        <div class="form-group">
            <label class="form-label">Course Code</label>
            <input class="form-control" @bind="_courseForm.CourseCode" placeholder="HIST01" disabled="@_editingCourseId.HasValue" />
        </div>
        <div class="form-group">
            <label class="form-label">Course Name</label>
            <input class="form-control" @bind="_courseForm.CourseName" placeholder="History" />
        </div>
    </div>
    <div class="form-group">
        <label class="form-label">Description (optional)</label>
        <input class="form-control" @bind="_courseForm.Description" />
    </div>

    @if (_editingCourseId.HasValue)
    {
        <div class="form-group">
            <label class="form-label">Topics in this course</label>
            @{
                var courseTopics = (_topics ?? []).Where(t => t.CourseId == _editingCourseId.Value && t.IsActive).OrderBy(t => t.TopicOrder).ToList();
            }
            @if (courseTopics.Count == 0)
            {
                <p style="color:var(--muted);font-size:0.85rem;margin:0;">No topics yet — add one from the Topics panel after saving.</p>
            }
            else
            {
                <ul class="topic-chip-list">
                    @foreach (var topic in courseTopics)
                    {
                        <li class="topic-chip">
                            <span>@topic.TopicOrder. @topic.TopicName</span>
                            <button type="button" class="topic-chip-remove" title="Remove topic" @onclick="() => RemoveTopicAsync(topic)">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </li>
                    }
                </ul>
            }
        </div>
    }

    @if (_courseFormError is not null)
    {
        <p class="form-error">@_courseFormError</p>
    }
    <div class="form-actions">
        <button type="button" class="btn-secondary" @onclick="() => _showCourseModal = false">Cancel</button>
        <button type="button" class="btn-primary" disabled="@_saving" @onclick="SaveCourseAsync">
            @(_saving ? "Saving..." : _editingCourseId.HasValue ? "Save Changes" : "Save Course")
        </button>
    </div>
</Modal>

<Modal IsVisible="_showTopicModal" Title="@(_editingTopicId.HasValue ? "Edit Topic" : "Add Topic")"
       Subtitle="@(_editingTopicId.HasValue ? "Update this topic's details." : "Add a topic taught within a course.")"
       OnClose="() => _showTopicModal = false">
    <div class="form-group">
        <label class="form-label">Course</label>
        <select class="form-control" @bind="_topicForm.CourseId" disabled="@_editingTopicId.HasValue">
            <option value="0">Select a course...</option>
            @foreach (var course in _courses ?? [])
            {
                <option value="@course.Id">@course.CourseName</option>
            }
        </select>
    </div>
    <div class="form-row">
        <div class="form-group">
            <label class="form-label">Topic Name</label>
            <input class="form-control" @bind="_topicForm.TopicName" />
        </div>
        <div class="form-group">
            <label class="form-label">Order</label>
            <input type="number" min="0" class="form-control" @bind="_topicForm.TopicOrder" />
        </div>
    </div>
    <div class="form-group">
        <label class="form-label">Description (optional)</label>
        <input class="form-control" @bind="_topicForm.Description" />
    </div>
    @if (_topicFormError is not null)
    {
        <p class="form-error">@_topicFormError</p>
    }
    <div class="form-actions">
        <button type="button" class="btn-secondary" @onclick="() => _showTopicModal = false">Cancel</button>
        <button type="button" class="btn-primary" disabled="@_saving" @onclick="SaveTopicAsync">
            @(_saving ? "Saving..." : _editingTopicId.HasValue ? "Save Changes" : "Save Topic")
        </button>
    </div>
</Modal>

@if (_courses is null || _topics is null)
{
    <p>Loading...</p>
}
else
{
    <div class="dashboard-grid">
        <div class="section-tabs">
            <button type="button" class="section-tab @(_activeSection == CourseSection.Courses ? "active" : "")" @onclick="ShowCoursesSection">
                Course <span class="section-tab-count">(@_courses.Count)</span>
            </button>
            <button type="button" class="section-tab @(_activeSection == CourseSection.Topics ? "active" : "")" @onclick="ShowTopicsSection">
                Topics <span class="section-tab-count">(@_topics.Count)</span>
            </button>
        </div>

        @if (_activeSection == CourseSection.Courses)
        {
        <DataTablePanel TItem="CourseDto" Items="_courses"
                         Tabs="_courseTabs"
                         SearchPredicate="@((c, q) => c.CourseName.Contains(q, StringComparison.OrdinalIgnoreCase) || c.CourseCode.Contains(q, StringComparison.OrdinalIgnoreCase))"
                         SearchPlaceholder="Search courses..."
                         Sort="SortCourseItems">
            <ChildContent Context="items">
                <div class="table-scroll">
                    <table class="pro-table">
                        <thead>
                            <tr>
                                <SortableHeader Label="Code" Column="code" CurrentColumn="_courseSort" Ascending="_courseAsc" OnSort="SortCourses" />
                                <SortableHeader Label="Name" Column="name" CurrentColumn="_courseSort" Ascending="_courseAsc" OnSort="SortCourses" />
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var course in items)
                            {
                                <tr>
                                    <td>@course.CourseCode</td>
                                    <td>@course.CourseName</td>
                                    <td><span class="status-pill @(course.IsActive ? "pill-green" : "pill-red")">@(course.IsActive ? "Active" : "Inactive")</span></td>
                                    <td>
                                        <div class="action-icons">
                                            <button type="button" class="icon-btn-circle" title="Edit course" @onclick="() => OpenEditCourseModal(course)">
                                                <i class="bi bi-pencil-fill"></i>
                                            </button>
                                            @if (course.IsActive)
                                            {
                                                <button type="button" class="icon-btn-circle icon-btn-circle-danger" title="Make inactive" @onclick="() => DeactivateCourseAsync(course)">
                                                    <i class="bi bi-toggle-on"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="icon-btn-circle" title="Make active" @onclick="() => ActivateCourseAsync(course)">
                                                    <i class="bi bi-toggle-off"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                            @if (items.Count == 0)
                            {
                                <tr class="empty-row"><td colspan="4">No courses match.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </ChildContent>
        </DataTablePanel>
        }
        else
        {
        <DataTablePanel TItem="TopicDto" Items="_topics"
                         Title="Topics"
                         SearchPredicate="@((t, q) => t.TopicName.Contains(q, StringComparison.OrdinalIgnoreCase))"
                         SearchPlaceholder="Search topics..."
                         Sort="SortTopicItems">
            <ChildContent Context="items">
                <div class="table-scroll">
                    <table class="pro-table">
                        <thead>
                            <tr>
                                <SortableHeader Label="#" Column="order" CurrentColumn="_topicSort" Ascending="_topicAsc" OnSort="SortTopics" />
                                <SortableHeader Label="Topic" Column="name" CurrentColumn="_topicSort" Ascending="_topicAsc" OnSort="SortTopics" />
                                <th>Course</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var topic in items)
                            {
                                <tr>
                                    <td>@topic.TopicOrder</td>
                                    <td>@topic.TopicName</td>
                                    <td>@CourseName(topic.CourseId)</td>
                                    <td><span class="status-pill @(topic.IsActive ? "pill-green" : "pill-red")">@(topic.IsActive ? "Active" : "Removed")</span></td>
                                    <td>
                                        <div class="action-icons">
                                            <button type="button" class="icon-btn-circle" title="Edit topic" @onclick="() => OpenEditTopicModal(topic)">
                                                <i class="bi bi-pencil-fill"></i>
                                            </button>
                                            @if (topic.IsActive)
                                            {
                                                <button type="button" class="icon-btn-circle icon-btn-circle-danger" title="Remove topic" @onclick="() => RemoveTopicAsync(topic)">
                                                    <i class="bi bi-trash-fill"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                            @if (items.Count == 0)
                            {
                                <tr class="empty-row"><td colspan="5">No topics match.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </ChildContent>
        </DataTablePanel>
        }
    </div>
}

@code {
    private enum CourseSection { Courses, Topics }

    private List<CourseDto>? _courses;
    private List<TopicDto>? _topics;

    private CourseSection _activeSection = CourseSection.Courses;

    private string _courseSort = "name";
    private bool _courseAsc = true;
    private string _topicSort = "order";
    private bool _topicAsc = true;

    private List<TableTab<CourseDto>> _courseTabs = [];

    private List<AddMenuItem> _addOptions = [];
    private bool _showCourseModal;
    private bool _showTopicModal;
    private bool _saving;
    private int? _editingCourseId;
    private int? _editingTopicId;
    private string? _courseFormError;
    private string? _topicFormError;
    private CourseFormModel _courseForm = new();
    private TopicFormModel _topicForm = new();

    protected override async Task OnInitializedAsync()
    {
        _courses = await Mediator.Send(new GetCoursesListQuery());
        _topics = await Mediator.Send(new GetTopicsListQuery());

        _addOptions =
        [
            new("Add Course", EventCallback.Factory.Create(this, OpenCourseModal)),
            new("Add Topic", EventCallback.Factory.Create(this, OpenTopicModal)),
        ];

        _courseTabs =
        [
            new("all", "All"),
            new("active", "Active", c => c.IsActive),
            new("inactive", "Inactive", c => !c.IsActive),
        ];
    }

    private void ShowCoursesSection() => _activeSection = CourseSection.Courses;

    private void ShowTopicsSection() => _activeSection = CourseSection.Topics;

    private void SortCourses(string column)
    {
        _courseAsc = _courseSort == column ? !_courseAsc : true;
        _courseSort = column;
    }

    private void SortTopics(string column)
    {
        _topicAsc = _topicSort == column ? !_topicAsc : true;
        _topicSort = column;
    }

    private List<CourseDto> SortCourseItems(IReadOnlyList<CourseDto> items)
    {
        IEnumerable<CourseDto> query = _courseSort switch
        {
            "code" => items.OrderBy(c => c.CourseCode),
            _ => items.OrderBy(c => c.CourseName),
        };
        return (_courseAsc ? query : query.Reverse()).ToList();
    }

    private List<TopicDto> SortTopicItems(IReadOnlyList<TopicDto> items)
    {
        IEnumerable<TopicDto> query = _topicSort switch
        {
            "name" => items.OrderBy(t => t.TopicName),
            _ => items.OrderBy(t => t.TopicOrder),
        };
        return (_topicAsc ? query : query.Reverse()).ToList();
    }

    private string CourseName(int courseId) => _courses?.FirstOrDefault(c => c.Id == courseId)?.CourseName ?? "Unknown";

    private async Task RefreshAsync()
    {
        _courses = await Mediator.Send(new GetCoursesListQuery());
        _topics = await Mediator.Send(new GetTopicsListQuery());
    }

    private void OpenCourseModal()
    {
        _editingCourseId = null;
        _courseForm = new CourseFormModel();
        _courseFormError = null;
        _showCourseModal = true;
    }

    private void OpenEditCourseModal(CourseDto course)
    {
        _editingCourseId = course.Id;
        _courseForm = new CourseFormModel
        {
            CourseCode = course.CourseCode,
            CourseName = course.CourseName,
            Description = course.Description,
        };
        _courseFormError = null;
        _showCourseModal = true;
    }

    private void OpenTopicModal()
    {
        _editingTopicId = null;
        _topicForm = new TopicFormModel();
        _topicFormError = null;
        _showTopicModal = true;
    }

    private void OpenEditTopicModal(TopicDto topic)
    {
        _editingTopicId = topic.Id;
        _topicForm = new TopicFormModel
        {
            CourseId = topic.CourseId,
            TopicName = topic.TopicName,
            TopicOrder = topic.TopicOrder,
            Description = topic.Description,
        };
        _topicFormError = null;
        _showTopicModal = true;
    }

    private async Task SaveCourseAsync()
    {
        _courseFormError = null;
        _saving = true;
        try
        {
            var description = string.IsNullOrWhiteSpace(_courseForm.Description) ? null : _courseForm.Description;

            Result result = _editingCourseId.HasValue
                ? await Mediator.Send(new UpdateCourseCommand(_editingCourseId.Value, _courseForm.CourseName, description))
                : await Mediator.Send(new CreateCourseCommand(_courseForm.CourseCode, _courseForm.CourseName, description));

            if (!result.Succeeded)
            {
                _courseFormError = string.Join(" ", result.Errors);
                return;
            }

            _showCourseModal = false;
            var wasEditing = _editingCourseId.HasValue;
            await RefreshAsync();
            Toast.ShowSuccess(
                wasEditing ? "Course updated" : "Course added",
                wasEditing ? $"{_courseForm.CourseName}'s details were saved." : $"{_courseForm.CourseName} has been created.");
        }
        catch (ValidationException ex)
        {
            _courseFormError = string.Join(" ", ex.Errors.SelectMany(e => e.Value));
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeactivateCourseAsync(CourseDto course)
    {
        var confirmed = await Confirm.ConfirmAsync(
            "Make this course inactive?",
            $"{course.CourseName} will be marked inactive. This can be reversed later.",
            confirmText: "Make Inactive");

        if (!confirmed)
        {
            return;
        }

        var result = await Mediator.Send(new DeactivateCourseCommand(course.Id));
        if (result.Succeeded)
        {
            Toast.ShowSuccess("Course deactivated", $"{course.CourseName} is now inactive.");
            await RefreshAsync();
        }
        else
        {
            Toast.ShowError("Couldn't deactivate course", string.Join(" ", result.Errors));
        }
    }

    private async Task ActivateCourseAsync(CourseDto course)
    {
        var result = await Mediator.Send(new ActivateCourseCommand(course.Id));
        if (result.Succeeded)
        {
            Toast.ShowSuccess("Course activated", $"{course.CourseName} is now active.");
            await RefreshAsync();
        }
        else
        {
            Toast.ShowError("Couldn't activate course", string.Join(" ", result.Errors));
        }
    }

    private async Task SaveTopicAsync()
    {
        _topicFormError = null;
        _saving = true;
        try
        {
            if (_topicForm.CourseId == 0)
            {
                _topicFormError = "Select a course.";
                return;
            }

            var description = string.IsNullOrWhiteSpace(_topicForm.Description) ? null : _topicForm.Description;

            Result result = _editingTopicId.HasValue
                ? await Mediator.Send(new UpdateTopicCommand(_editingTopicId.Value, _topicForm.TopicName, _topicForm.TopicOrder, description))
                : await Mediator.Send(new CreateTopicCommand(_topicForm.CourseId, _topicForm.TopicName, _topicForm.TopicOrder, description));

            if (!result.Succeeded)
            {
                _topicFormError = string.Join(" ", result.Errors);
                return;
            }

            _showTopicModal = false;
            var wasEditing = _editingTopicId.HasValue;
            await RefreshAsync();
            Toast.ShowSuccess(
                wasEditing ? "Topic updated" : "Topic added",
                wasEditing ? $"{_topicForm.TopicName}'s details were saved." : $"{_topicForm.TopicName} has been created.");
        }
        catch (ValidationException ex)
        {
            _topicFormError = string.Join(" ", ex.Errors.SelectMany(e => e.Value));
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task RemoveTopicAsync(TopicDto topic)
    {
        var confirmed = await Confirm.ConfirmAsync(
            "Remove this topic?",
            $"{topic.TopicName} will no longer be scored during evaluations. Past evaluation results for it are kept.",
            confirmText: "Remove Topic");

        if (!confirmed)
        {
            return;
        }

        var result = await Mediator.Send(new DeactivateTopicCommand(topic.Id));
        if (result.Succeeded)
        {
            Toast.ShowSuccess("Topic removed", $"{topic.TopicName} has been removed from the course.");
            await RefreshAsync();
        }
        else
        {
            Toast.ShowError("Couldn't remove topic", string.Join(" ", result.Errors));
        }
    }

    private class CourseFormModel
    {
        public string CourseCode { get; set; } = string.Empty;
        public string CourseName { get; set; } = string.Empty;
        public string? Description { get; set; }
    }

    private class TopicFormModel
    {
        public int CourseId { get; set; }
        public string TopicName { get; set; } = string.Empty;
        public int TopicOrder { get; set; } = 1;
        public string? Description { get; set; }
    }
}
