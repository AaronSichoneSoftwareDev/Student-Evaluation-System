@page "/academic-setup"
@using Evaluate.Application.AcademicYears.Queries.GetAcademicYearsList
@using Evaluate.Application.AcademicYears.Commands.CreateAcademicYear
@using Evaluate.Application.Terms.Queries.GetTermsList
@using Evaluate.Application.Terms.Commands.CreateTerm
@using Evaluate.Application.Classes.Queries.GetClassesList
@using Evaluate.Application.Classes.Commands.CreateClass
@using Evaluate.Application.Common.Exceptions
@using MediatR
@inject IMediator Mediator
@inject ToastService Toast

<PageTitle>Academic Setup - Evaluate</PageTitle>

<PageHeader Title="Academic Setup" Subtitle="Academic years, terms, and classes."
            AddOptions="_addOptions" OnRefresh="RefreshAsync" />

<Modal IsVisible="_showYearModal" Title="Add Academic Year" Subtitle="Define a new academic year and its date range." OnClose="() => _showYearModal = false">
    <div class="form-group">
        <label class="form-label">Year Name</label>
        <input class="form-control" @bind="_yearForm.YearName" placeholder="2027" />
    </div>
    <div class="form-row">
        <div class="form-group">
            <label class="form-label">Start Date</label>
            <input type="date" class="form-control" @bind="_yearForm.StartDate" />
        </div>
        <div class="form-group">
            <label class="form-label">End Date</label>
            <input type="date" class="form-control" @bind="_yearForm.EndDate" />
        </div>
    </div>
    @if (_yearFormError is not null)
    {
        <p class="form-error">@_yearFormError</p>
    }
    <div class="form-actions">
        <button type="button" class="btn-secondary" @onclick="() => _showYearModal = false">Cancel</button>
        <button type="button" class="btn-primary" disabled="@_saving" @onclick="SaveYearAsync">@(_saving ? "Saving..." : "Save Year")</button>
    </div>
</Modal>

<Modal IsVisible="_showTermModal" Title="Add Term" Subtitle="Add a new term to an existing academic year." OnClose="() => _showTermModal = false">
    <div class="form-group">
        <label class="form-label">Academic Year</label>
        <select class="form-control" @bind="_termForm.AcademicYearId">
            <option value="0">Select a year...</option>
            @foreach (var year in _years ?? [])
            {
                <option value="@year.Id">@year.YearName</option>
            }
        </select>
    </div>
    <div class="form-row">
        <div class="form-group">
            <label class="form-label">Term Name</label>
            <input class="form-control" @bind="_termForm.TermName" placeholder="Term 1" />
        </div>
        <div class="form-group">
            <label class="form-label">Term #</label>
            <input type="number" min="1" class="form-control" @bind="_termForm.TermNumber" />
        </div>
    </div>
    <div class="form-row">
        <div class="form-group">
            <label class="form-label">Start Date</label>
            <input type="date" class="form-control" @bind="_termForm.StartDate" />
        </div>
        <div class="form-group">
            <label class="form-label">End Date</label>
            <input type="date" class="form-control" @bind="_termForm.EndDate" />
        </div>
    </div>
    @if (_termFormError is not null)
    {
        <p class="form-error">@_termFormError</p>
    }
    <div class="form-actions">
        <button type="button" class="btn-secondary" @onclick="() => _showTermModal = false">Cancel</button>
        <button type="button" class="btn-primary" disabled="@_saving" @onclick="SaveTermAsync">@(_saving ? "Saving..." : "Save Term")</button>
    </div>
</Modal>

<Modal IsVisible="_showClassModal" Title="Add Class" Subtitle="Create a new class for students to enroll in." OnClose="() => _showClassModal = false">
    <div class="form-row">
        <div class="form-group">
            <label class="form-label">Class Name</label>
            <input class="form-control" @bind="_classForm.ClassName" placeholder="Grade 9A" />
        </div>
        <div class="form-group">
            <label class="form-label">Grade Level</label>
            <input class="form-control" @bind="_classForm.GradeLevel" placeholder="Grade 9" />
        </div>
    </div>
    <div class="form-group">
        <label class="form-label">Description (optional)</label>
        <input class="form-control" @bind="_classForm.Description" />
    </div>
    @if (_classFormError is not null)
    {
        <p class="form-error">@_classFormError</p>
    }
    <div class="form-actions">
        <button type="button" class="btn-secondary" @onclick="() => _showClassModal = false">Cancel</button>
        <button type="button" class="btn-primary" disabled="@_saving" @onclick="SaveClassAsync">@(_saving ? "Saving..." : "Save Class")</button>
    </div>
</Modal>

@if (_years is null || _terms is null || _classes is null)
{
    <p>Loading...</p>
}
else
{
    <div class="dashboard-grid">
        <DataTablePanel TItem="AcademicYearDto" Items="_years"
                         Tabs="_yearTabs"
                         SearchPredicate="@((y, q) => y.YearName.Contains(q, StringComparison.OrdinalIgnoreCase))"
                         SearchPlaceholder="Search years..."
                         Sort="SortYearItems">
            <ChildContent Context="items">
                <div class="table-scroll">
                    <table class="pro-table">
                        <thead>
                            <tr>
                                <SortableHeader Label="Year" Column="year" CurrentColumn="_yearSort" Ascending="_yearAsc" OnSort="SortYears" />
                                <SortableHeader Label="Starts" Column="start" CurrentColumn="_yearSort" Ascending="_yearAsc" OnSort="SortYears" />
                                <SortableHeader Label="Ends" Column="end" CurrentColumn="_yearSort" Ascending="_yearAsc" OnSort="SortYears" />
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var year in items)
                            {
                                <tr>
                                    <td>@year.YearName</td>
                                    <td>@year.StartDate.ToString("MMM d, yyyy")</td>
                                    <td>@year.EndDate.ToString("MMM d, yyyy")</td>
                                    <td>
                                        @if (year.IsCurrent)
                                        {
                                            <span class="status-pill pill-green">Current</span>
                                        }
                                        else
                                        {
                                            <span class="status-pill @(year.IsActive ? "pill-amber" : "pill-red")">@(year.IsActive ? "Active" : "Inactive")</span>
                                        }
                                    </td>
                                </tr>
                            }
                            @if (items.Count == 0)
                            {
                                <tr class="empty-row"><td colspan="4">No academic years match.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </ChildContent>
        </DataTablePanel>

        <DataTablePanel TItem="TermDto" Items="_terms"
                         Title="Terms"
                         SearchPredicate="@((t, q) => t.TermName.Contains(q, StringComparison.OrdinalIgnoreCase))"
                         SearchPlaceholder="Search terms..."
                         Sort="SortTermItems">
            <ChildContent Context="items">
                <div class="table-scroll">
                    <table class="pro-table">
                        <thead>
                            <tr>
                                <SortableHeader Label="Term" Column="name" CurrentColumn="_termSort" Ascending="_termAsc" OnSort="SortTerms" />
                                <SortableHeader Label="#" Column="number" CurrentColumn="_termSort" Ascending="_termAsc" OnSort="SortTerms" />
                                <SortableHeader Label="Starts" Column="start" CurrentColumn="_termSort" Ascending="_termAsc" OnSort="SortTerms" />
                                <SortableHeader Label="Ends" Column="end" CurrentColumn="_termSort" Ascending="_termAsc" OnSort="SortTerms" />
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var term in items)
                            {
                                <tr>
                                    <td>@term.TermName</td>
                                    <td>@term.TermNumber</td>
                                    <td>@term.StartDate.ToString("MMM d, yyyy")</td>
                                    <td>@term.EndDate.ToString("MMM d, yyyy")</td>
                                </tr>
                            }
                            @if (items.Count == 0)
                            {
                                <tr class="empty-row"><td colspan="4">No terms match.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </ChildContent>
        </DataTablePanel>

        <DataTablePanel TItem="ClassDto" Items="_classes"
                         Tabs="_classTabs"
                         SearchPredicate="@((c, q) => c.ClassName.Contains(q, StringComparison.OrdinalIgnoreCase) || c.GradeLevel.Contains(q, StringComparison.OrdinalIgnoreCase))"
                         SearchPlaceholder="Search classes..."
                         Sort="SortClassItems">
            <ChildContent Context="items">
                <div class="table-scroll">
                    <table class="pro-table">
                        <thead>
                            <tr>
                                <SortableHeader Label="Class" Column="name" CurrentColumn="_classSort" Ascending="_classAsc" OnSort="SortClasses" />
                                <SortableHeader Label="Grade Level" Column="grade" CurrentColumn="_classSort" Ascending="_classAsc" OnSort="SortClasses" />
                                <th>Description</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var schoolClass in items)
                            {
                                <tr>
                                    <td>@schoolClass.ClassName</td>
                                    <td>@schoolClass.GradeLevel</td>
                                    <td>@(schoolClass.Description ?? "—")</td>
                                    <td><span class="status-pill @(schoolClass.IsActive ? "pill-green" : "pill-red")">@(schoolClass.IsActive ? "Active" : "Inactive")</span></td>
                                </tr>
                            }
                            @if (items.Count == 0)
                            {
                                <tr class="empty-row"><td colspan="4">No classes match.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </ChildContent>
        </DataTablePanel>
    </div>
}

@code {
    private List<AcademicYearDto>? _years;
    private List<TermDto>? _terms;
    private List<ClassDto>? _classes;

    private string _yearSort = "start";
    private bool _yearAsc = false;
    private string _termSort = "number";
    private bool _termAsc = true;
    private string _classSort = "name";
    private bool _classAsc = true;

    private List<TableTab<AcademicYearDto>> _yearTabs = [];
    private List<TableTab<ClassDto>> _classTabs = [];

    private List<AddMenuItem> _addOptions = [];
    private bool _showYearModal;
    private bool _showTermModal;
    private bool _showClassModal;
    private bool _saving;
    private string? _yearFormError;
    private string? _termFormError;
    private string? _classFormError;
    private YearFormModel _yearForm = new();
    private TermFormModel _termForm = new();
    private ClassFormModel _classForm = new();

    protected override async Task OnInitializedAsync()
    {
        _years = await Mediator.Send(new GetAcademicYearsListQuery());
        _terms = await Mediator.Send(new GetTermsListQuery());
        _classes = await Mediator.Send(new GetClassesListQuery());

        _addOptions =
        [
            new("Add Academic Year", EventCallback.Factory.Create(this, OpenYearModal)),
            new("Add Term", EventCallback.Factory.Create(this, OpenTermModal)),
            new("Add Class", EventCallback.Factory.Create(this, OpenClassModal)),
        ];

        _yearTabs =
        [
            new("all", "All"),
            new("current", "Current", y => y.IsCurrent),
            new("active", "Active", y => y.IsActive && !y.IsCurrent),
            new("inactive", "Inactive", y => !y.IsActive),
        ];

        _classTabs =
        [
            new("all", "All"),
            new("active", "Active", c => c.IsActive),
            new("inactive", "Inactive", c => !c.IsActive),
        ];
    }

    private void SortYears(string column)
    {
        _yearAsc = _yearSort == column ? !_yearAsc : true;
        _yearSort = column;
    }

    private void SortTerms(string column)
    {
        _termAsc = _termSort == column ? !_termAsc : true;
        _termSort = column;
    }

    private void SortClasses(string column)
    {
        _classAsc = _classSort == column ? !_classAsc : true;
        _classSort = column;
    }

    private List<AcademicYearDto> SortYearItems(IReadOnlyList<AcademicYearDto> items)
    {
        IEnumerable<AcademicYearDto> query = _yearSort switch
        {
            "year" => items.OrderBy(y => y.YearName),
            "end" => items.OrderBy(y => y.EndDate),
            _ => items.OrderBy(y => y.StartDate),
        };
        return (_yearAsc ? query : query.Reverse()).ToList();
    }

    private List<TermDto> SortTermItems(IReadOnlyList<TermDto> items)
    {
        IEnumerable<TermDto> query = _termSort switch
        {
            "name" => items.OrderBy(t => t.TermName),
            "start" => items.OrderBy(t => t.StartDate),
            "end" => items.OrderBy(t => t.EndDate),
            _ => items.OrderBy(t => t.TermNumber),
        };
        return (_termAsc ? query : query.Reverse()).ToList();
    }

    private List<ClassDto> SortClassItems(IReadOnlyList<ClassDto> items)
    {
        IEnumerable<ClassDto> query = _classSort switch
        {
            "grade" => items.OrderBy(c => c.GradeLevel),
            _ => items.OrderBy(c => c.ClassName),
        };
        return (_classAsc ? query : query.Reverse()).ToList();
    }

    private async Task RefreshAsync()
    {
        _years = await Mediator.Send(new GetAcademicYearsListQuery());
        _terms = await Mediator.Send(new GetTermsListQuery());
        _classes = await Mediator.Send(new GetClassesListQuery());
    }

    private void OpenYearModal()
    {
        _yearForm = new YearFormModel();
        _yearFormError = null;
        _showYearModal = true;
    }

    private void OpenTermModal()
    {
        _termForm = new TermFormModel();
        _termFormError = null;
        _showTermModal = true;
    }

    private void OpenClassModal()
    {
        _classForm = new ClassFormModel();
        _classFormError = null;
        _showClassModal = true;
    }

    private async Task SaveYearAsync()
    {
        _yearFormError = null;
        _saving = true;
        try
        {
            var command = new CreateAcademicYearCommand(_yearForm.YearName, DateOnly.FromDateTime(_yearForm.StartDate), DateOnly.FromDateTime(_yearForm.EndDate));
            var result = await Mediator.Send(command);
            if (!result.Succeeded)
            {
                _yearFormError = string.Join(" ", result.Errors);
                return;
            }
            _showYearModal = false;
            await RefreshAsync();
            Toast.ShowSuccess("Academic year added", $"{_yearForm.YearName} has been created.");
        }
        catch (ValidationException ex)
        {
            _yearFormError = string.Join(" ", ex.Errors.SelectMany(e => e.Value));
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SaveTermAsync()
    {
        _termFormError = null;
        _saving = true;
        try
        {
            if (_termForm.AcademicYearId == 0)
            {
                _termFormError = "Select an academic year.";
                return;
            }

            var command = new CreateTermCommand(_termForm.AcademicYearId, _termForm.TermName, _termForm.TermNumber, DateOnly.FromDateTime(_termForm.StartDate), DateOnly.FromDateTime(_termForm.EndDate));
            var result = await Mediator.Send(command);
            if (!result.Succeeded)
            {
                _termFormError = string.Join(" ", result.Errors);
                return;
            }
            _showTermModal = false;
            await RefreshAsync();
            Toast.ShowSuccess("Term added", $"{_termForm.TermName} has been created.");
        }
        catch (ValidationException ex)
        {
            _termFormError = string.Join(" ", ex.Errors.SelectMany(e => e.Value));
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SaveClassAsync()
    {
        _classFormError = null;
        _saving = true;
        try
        {
            var command = new CreateClassCommand(_classForm.ClassName, _classForm.GradeLevel, string.IsNullOrWhiteSpace(_classForm.Description) ? null : _classForm.Description);
            var result = await Mediator.Send(command);
            if (!result.Succeeded)
            {
                _classFormError = string.Join(" ", result.Errors);
                return;
            }
            _showClassModal = false;
            await RefreshAsync();
            Toast.ShowSuccess("Class added", $"{_classForm.ClassName} has been created.");
        }
        catch (ValidationException ex)
        {
            _classFormError = string.Join(" ", ex.Errors.SelectMany(e => e.Value));
        }
        finally
        {
            _saving = false;
        }
    }

    private class YearFormModel
    {
        public string YearName { get; set; } = string.Empty;
        public DateTime StartDate { get; set; } = new(DateTime.Today.Year, 1, 1);
        public DateTime EndDate { get; set; } = new(DateTime.Today.Year, 12, 31);
    }

    private class TermFormModel
    {
        public int AcademicYearId { get; set; }
        public string TermName { get; set; } = string.Empty;
        public int TermNumber { get; set; } = 1;
        public DateTime StartDate { get; set; } = DateTime.Today;
        public DateTime EndDate { get; set; } = DateTime.Today.AddMonths(3);
    }

    private class ClassFormModel
    {
        public string ClassName { get; set; } = string.Empty;
        public string GradeLevel { get; set; } = string.Empty;
        public string? Description { get; set; }
    }
}
