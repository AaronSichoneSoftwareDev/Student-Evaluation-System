@page "/academic-setup"
@using Evaluate.Application.AcademicYears.Queries.GetAcademicYearsList
@using Evaluate.Application.AcademicYears.Commands.CreateAcademicYear
@using Evaluate.Application.AcademicYears.Commands.UpdateAcademicYear
@using Evaluate.Application.AcademicYears.Commands.DeactivateAcademicYear
@using Evaluate.Application.Terms.Queries.GetTermsList
@using Evaluate.Application.Terms.Commands.CreateTerm
@using Evaluate.Application.Terms.Commands.UpdateTerm
@using Evaluate.Application.Terms.Commands.DeactivateTerm
@using Evaluate.Application.Common.Exceptions
@using Evaluate.Application.Common.Models
@using MediatR
@inject IMediator Mediator
@inject ToastService Toast
@inject ConfirmService Confirm

<PageTitle>Academic Setup - Evaluate</PageTitle>

<PageHeader Title="Academic Setup" Subtitle="Academic years and terms."
            AddOptions="_addOptions" OnRefresh="RefreshAsync" />

<Modal IsVisible="_showYearModal" Title="@(_editingYearId.HasValue ? "Edit Academic Year" : "Add Academic Year")"
       Subtitle="@(_editingYearId.HasValue ? "Update this academic year's name and date range." : "Define a new academic year and its date range.")"
       OnClose="() => _showYearModal = false">
    <div class="form-group">
        <label class="form-label">Year Name</label>
        <input class="form-control" @bind="_yearForm.YearName" placeholder="2027" />
    </div>
    <div class="form-row">
        <div class="form-group">
            <label class="form-label">Start Date</label>
            <input type="date" class="form-control" @bind="_yearForm.StartDate" />
        </div>
        <div class="form-group">
            <label class="form-label">End Date</label>
            <input type="date" class="form-control" @bind="_yearForm.EndDate" />
        </div>
    </div>
    @if (_yearFormError is not null)
    {
        <p class="form-error">@_yearFormError</p>
    }
    <div class="form-actions">
        <button type="button" class="btn-secondary" @onclick="() => _showYearModal = false">Cancel</button>
        <button type="button" class="btn-primary" disabled="@_saving" @onclick="SaveYearAsync">
            @(_saving ? "Saving..." : _editingYearId.HasValue ? "Save Changes" : "Save Year")
        </button>
    </div>
</Modal>

<Modal IsVisible="_showTermModal" Title="@(_editingTermId.HasValue ? "Edit Term" : "Add Term")"
       Subtitle="@(_editingTermId.HasValue ? "Update this term's details." : "Add a new term to an existing academic year.")"
       OnClose="() => _showTermModal = false">
    <div class="form-group">
        <label class="form-label">Academic Year</label>
        <select class="form-control" @bind="_termForm.AcademicYearId" disabled="@_editingTermId.HasValue">
            <option value="0">Select a year...</option>
            @foreach (var year in _years ?? [])
            {
                <option value="@year.Id">@year.YearName</option>
            }
        </select>
    </div>
    <div class="form-row">
        <div class="form-group">
            <label class="form-label">Term Name</label>
            <input class="form-control" @bind="_termForm.TermName" placeholder="Term 1" />
        </div>
        <div class="form-group">
            <label class="form-label">Term #</label>
            <input type="number" min="1" class="form-control" @bind="_termForm.TermNumber" />
        </div>
    </div>
    <div class="form-row">
        <div class="form-group">
            <label class="form-label">Start Date</label>
            <input type="date" class="form-control" @bind="_termForm.StartDate" />
        </div>
        <div class="form-group">
            <label class="form-label">End Date</label>
            <input type="date" class="form-control" @bind="_termForm.EndDate" />
        </div>
    </div>
    @if (_termFormError is not null)
    {
        <p class="form-error">@_termFormError</p>
    }
    <div class="form-actions">
        <button type="button" class="btn-secondary" @onclick="() => _showTermModal = false">Cancel</button>
        <button type="button" class="btn-primary" disabled="@_saving" @onclick="SaveTermAsync">
            @(_saving ? "Saving..." : _editingTermId.HasValue ? "Save Changes" : "Save Term")
        </button>
    </div>
</Modal>

@if (_years is null || _terms is null)
{
    <p>Loading...</p>
}
else
{
    <div class="dashboard-grid">
        <div class="section-tabs">
            <button type="button" class="section-tab @(_activeSection == AcademicSection.Years ? "active" : "")" @onclick="ShowYearsSection">
                Academic Year <span class="section-tab-count">(@_years.Count)</span>
            </button>
            <button type="button" class="section-tab @(_activeSection == AcademicSection.Terms ? "active" : "")" @onclick="ShowTermsSection">
                Term <span class="section-tab-count">(@_terms.Count)</span>
            </button>
        </div>

        @if (_activeSection == AcademicSection.Years)
        {
            <DataTablePanel TItem="AcademicYearDto" Items="_years"
                             Tabs="_yearTabs"
                             SearchPredicate="@((y, q) => y.YearName.Contains(q, StringComparison.OrdinalIgnoreCase))"
                             SearchPlaceholder="Search years..."
                             Sort="SortYearItems">
                <ChildContent Context="items">
                    <div class="table-scroll">
                        <table class="pro-table">
                            <thead>
                                <tr>
                                    <SortableHeader Label="Year" Column="year" CurrentColumn="_yearSort" Ascending="_yearAsc" OnSort="SortYears" />
                                    <SortableHeader Label="Starts" Column="start" CurrentColumn="_yearSort" Ascending="_yearAsc" OnSort="SortYears" />
                                    <SortableHeader Label="Ends" Column="end" CurrentColumn="_yearSort" Ascending="_yearAsc" OnSort="SortYears" />
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var year in items)
                                {
                                    <tr>
                                        <td>@year.YearName</td>
                                        <td>@year.StartDate.ToString("MMM d, yyyy")</td>
                                        <td>@year.EndDate.ToString("MMM d, yyyy")</td>
                                        <td>
                                            @if (year.IsCurrent)
                                            {
                                                <span class="status-pill pill-green">Current</span>
                                            }
                                            else
                                            {
                                                <span class="status-pill @(year.IsActive ? "pill-amber" : "pill-red")">@(year.IsActive ? "Active" : "Inactive")</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="action-icons">
                                                <button type="button" class="icon-btn-circle" title="Edit academic year" @onclick="() => OpenEditYearModal(year)">
                                                    <i class="bi bi-pencil-fill"></i>
                                                </button>
                                                @if (year.IsCurrent)
                                                {
                                                    <span class="icon-btn-circle icon-btn-circle-disabled" title="Can't delete the current academic year — mark a different year as current first.">
                                                        <i class="bi bi-trash"></i>
                                                    </span>
                                                }
                                                else
                                                {
                                                    <button type="button" class="icon-btn-circle icon-btn-circle-danger" title="Delete academic year" @onclick="() => DeleteYearAsync(year)">
                                                        <i class="bi bi-trash-fill"></i>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                                @if (items.Count == 0)
                                {
                                    <tr class="empty-row"><td colspan="5">No academic years match.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </ChildContent>
            </DataTablePanel>
        }
        else
        {
            <DataTablePanel TItem="TermDto" Items="_terms"
                             Title="Terms"
                             SearchPredicate="@((t, q) => t.TermName.Contains(q, StringComparison.OrdinalIgnoreCase))"
                             SearchPlaceholder="Search terms..."
                             Sort="SortTermItems">
                <ChildContent Context="items">
                    <div class="table-scroll">
                        <table class="pro-table">
                            <thead>
                                <tr>
                                    <SortableHeader Label="Term" Column="name" CurrentColumn="_termSort" Ascending="_termAsc" OnSort="SortTerms" />
                                    <SortableHeader Label="#" Column="number" CurrentColumn="_termSort" Ascending="_termAsc" OnSort="SortTerms" />
                                    <SortableHeader Label="Starts" Column="start" CurrentColumn="_termSort" Ascending="_termAsc" OnSort="SortTerms" />
                                    <SortableHeader Label="Ends" Column="end" CurrentColumn="_termSort" Ascending="_termAsc" OnSort="SortTerms" />
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var term in items)
                                {
                                    <tr>
                                        <td>@term.TermName</td>
                                        <td>@term.TermNumber</td>
                                        <td>@term.StartDate.ToString("MMM d, yyyy")</td>
                                        <td>@term.EndDate.ToString("MMM d, yyyy")</td>
                                        <td>
                                            @if (term.IsCurrent)
                                            {
                                                <span class="status-pill pill-green">Current</span>
                                            }
                                            else
                                            {
                                                <span class="status-pill @(term.IsActive ? "pill-amber" : "pill-red")">@(term.IsActive ? "Active" : "Inactive")</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="action-icons">
                                                <button type="button" class="icon-btn-circle" title="Edit term" @onclick="() => OpenEditTermModal(term)">
                                                    <i class="bi bi-pencil-fill"></i>
                                                </button>
                                                @if (term.IsCurrent)
                                                {
                                                    <span class="icon-btn-circle icon-btn-circle-disabled" title="Can't delete the current term — mark a different term as current first.">
                                                        <i class="bi bi-trash"></i>
                                                    </span>
                                                }
                                                else
                                                {
                                                    <button type="button" class="icon-btn-circle icon-btn-circle-danger" title="Delete term" @onclick="() => DeleteTermAsync(term)">
                                                        <i class="bi bi-trash-fill"></i>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                                @if (items.Count == 0)
                                {
                                    <tr class="empty-row"><td colspan="6">No terms match.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </ChildContent>
            </DataTablePanel>
        }
    </div>
}

@code {
    private enum AcademicSection { Years, Terms }

    private List<AcademicYearDto>? _years;
    private List<TermDto>? _terms;

    private AcademicSection _activeSection = AcademicSection.Years;

    private string _yearSort = "start";
    private bool _yearAsc = false;
    private string _termSort = "number";
    private bool _termAsc = true;

    private List<TableTab<AcademicYearDto>> _yearTabs = [];

    private List<AddMenuItem> _addOptions = [];
    private bool _showYearModal;
    private bool _showTermModal;
    private bool _saving;
    private int? _editingYearId;
    private int? _editingTermId;
    private string? _yearFormError;
    private string? _termFormError;
    private YearFormModel _yearForm = new();
    private TermFormModel _termForm = new();

    protected override async Task OnInitializedAsync()
    {
        _years = await Mediator.Send(new GetAcademicYearsListQuery());
        _terms = await Mediator.Send(new GetTermsListQuery());

        _addOptions =
        [
            new("Add Academic Year", EventCallback.Factory.Create(this, OpenYearModal)),
            new("Add Term", EventCallback.Factory.Create(this, OpenTermModal)),
        ];

        _yearTabs =
        [
            new("all", "All"),
            new("current", "Current", y => y.IsCurrent),
            new("active", "Active", y => y.IsActive && !y.IsCurrent),
            new("inactive", "Inactive", y => !y.IsActive),
        ];
    }

    private void ShowYearsSection() => _activeSection = AcademicSection.Years;

    private void ShowTermsSection() => _activeSection = AcademicSection.Terms;

    private void SortYears(string column)
    {
        _yearAsc = _yearSort == column ? !_yearAsc : true;
        _yearSort = column;
    }

    private void SortTerms(string column)
    {
        _termAsc = _termSort == column ? !_termAsc : true;
        _termSort = column;
    }

    private List<AcademicYearDto> SortYearItems(IReadOnlyList<AcademicYearDto> items)
    {
        IEnumerable<AcademicYearDto> query = _yearSort switch
        {
            "year" => items.OrderBy(y => y.YearName),
            "end" => items.OrderBy(y => y.EndDate),
            _ => items.OrderBy(y => y.StartDate),
        };
        return (_yearAsc ? query : query.Reverse()).ToList();
    }

    private List<TermDto> SortTermItems(IReadOnlyList<TermDto> items)
    {
        IEnumerable<TermDto> query = _termSort switch
        {
            "name" => items.OrderBy(t => t.TermName),
            "start" => items.OrderBy(t => t.StartDate),
            "end" => items.OrderBy(t => t.EndDate),
            _ => items.OrderBy(t => t.TermNumber),
        };
        return (_termAsc ? query : query.Reverse()).ToList();
    }

    private async Task RefreshAsync()
    {
        _years = await Mediator.Send(new GetAcademicYearsListQuery());
        _terms = await Mediator.Send(new GetTermsListQuery());
    }

    private void OpenYearModal()
    {
        _editingYearId = null;
        _yearForm = new YearFormModel();
        _yearFormError = null;
        _showYearModal = true;
    }

    private void OpenEditYearModal(AcademicYearDto year)
    {
        _editingYearId = year.Id;
        _yearForm = new YearFormModel
        {
            YearName = year.YearName,
            StartDate = year.StartDate.ToDateTime(TimeOnly.MinValue),
            EndDate = year.EndDate.ToDateTime(TimeOnly.MinValue),
        };
        _yearFormError = null;
        _showYearModal = true;
    }

    private void OpenTermModal()
    {
        _editingTermId = null;
        _termForm = new TermFormModel();
        _termFormError = null;
        _showTermModal = true;
    }

    private void OpenEditTermModal(TermDto term)
    {
        _editingTermId = term.Id;
        _termForm = new TermFormModel
        {
            AcademicYearId = term.AcademicYearId,
            TermName = term.TermName,
            TermNumber = term.TermNumber,
            StartDate = term.StartDate.ToDateTime(TimeOnly.MinValue),
            EndDate = term.EndDate.ToDateTime(TimeOnly.MinValue),
        };
        _termFormError = null;
        _showTermModal = true;
    }

    private async Task SaveYearAsync()
    {
        _yearFormError = null;
        _saving = true;
        try
        {
            var startDate = DateOnly.FromDateTime(_yearForm.StartDate);
            var endDate = DateOnly.FromDateTime(_yearForm.EndDate);

            Result result = _editingYearId.HasValue
                ? await Mediator.Send(new UpdateAcademicYearCommand(_editingYearId.Value, _yearForm.YearName, startDate, endDate))
                : await Mediator.Send(new CreateAcademicYearCommand(_yearForm.YearName, startDate, endDate));

            if (!result.Succeeded)
            {
                _yearFormError = string.Join(" ", result.Errors);
                return;
            }

            _showYearModal = false;
            var wasEditing = _editingYearId.HasValue;
            await RefreshAsync();
            Toast.ShowSuccess(
                wasEditing ? "Academic year updated" : "Academic year added",
                wasEditing ? $"{_yearForm.YearName}'s details were saved." : $"{_yearForm.YearName} has been created.");
        }
        catch (ValidationException ex)
        {
            _yearFormError = string.Join(" ", ex.Errors.SelectMany(e => e.Value));
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteYearAsync(AcademicYearDto year)
    {
        var confirmed = await Confirm.ConfirmAsync(
            "Delete this academic year?",
            $"{year.YearName} will be marked inactive. Terms and records under it are kept.",
            confirmText: "Delete");

        if (!confirmed)
        {
            return;
        }

        var result = await Mediator.Send(new DeactivateAcademicYearCommand(year.Id));
        if (result.Succeeded)
        {
            Toast.ShowSuccess("Academic year deleted", $"{year.YearName} has been removed.");
            await RefreshAsync();
        }
        else
        {
            Toast.ShowError("Couldn't delete academic year", string.Join(" ", result.Errors));
        }
    }

    private async Task SaveTermAsync()
    {
        _termFormError = null;
        _saving = true;
        try
        {
            if (_termForm.AcademicYearId == 0)
            {
                _termFormError = "Select an academic year.";
                return;
            }

            var startDate = DateOnly.FromDateTime(_termForm.StartDate);
            var endDate = DateOnly.FromDateTime(_termForm.EndDate);

            Result result = _editingTermId.HasValue
                ? await Mediator.Send(new UpdateTermCommand(_editingTermId.Value, _termForm.TermName, _termForm.TermNumber, startDate, endDate))
                : await Mediator.Send(new CreateTermCommand(_termForm.AcademicYearId, _termForm.TermName, _termForm.TermNumber, startDate, endDate));

            if (!result.Succeeded)
            {
                _termFormError = string.Join(" ", result.Errors);
                return;
            }

            _showTermModal = false;
            var wasEditing = _editingTermId.HasValue;
            await RefreshAsync();
            Toast.ShowSuccess(
                wasEditing ? "Term updated" : "Term added",
                wasEditing ? $"{_termForm.TermName}'s details were saved." : $"{_termForm.TermName} has been created.");
        }
        catch (ValidationException ex)
        {
            _termFormError = string.Join(" ", ex.Errors.SelectMany(e => e.Value));
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteTermAsync(TermDto term)
    {
        var confirmed = await Confirm.ConfirmAsync(
            "Delete this term?",
            $"{term.TermName} will be marked inactive. Evaluation records under it are kept.",
            confirmText: "Delete");

        if (!confirmed)
        {
            return;
        }

        var result = await Mediator.Send(new DeactivateTermCommand(term.Id));
        if (result.Succeeded)
        {
            Toast.ShowSuccess("Term deleted", $"{term.TermName} has been removed.");
            await RefreshAsync();
        }
        else
        {
            Toast.ShowError("Couldn't delete term", string.Join(" ", result.Errors));
        }
    }

    private class YearFormModel
    {
        public string YearName { get; set; } = string.Empty;
        public DateTime StartDate { get; set; } = new(DateTime.Today.Year, 1, 1);
        public DateTime EndDate { get; set; } = new(DateTime.Today.Year, 12, 31);
    }

    private class TermFormModel
    {
        public int AcademicYearId { get; set; }
        public string TermName { get; set; } = string.Empty;
        public int TermNumber { get; set; } = 1;
        public DateTime StartDate { get; set; } = DateTime.Today;
        public DateTime EndDate { get; set; } = DateTime.Today.AddMonths(3);
    }
}
