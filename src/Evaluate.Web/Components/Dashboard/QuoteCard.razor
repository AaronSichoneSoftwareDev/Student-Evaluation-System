@using Evaluate.Application.Dashboard

<div class="card quote-card">
    <div class="quote-mark">&ldquo;</div>
    <p class="quote-text">@Quote.Text</p>
    <div class="quote-author">
        <div class="avatar" style="background:rgba(255,255,255,0.25);color:#fff;">@Quote.Initials</div>
        <div>
            <div class="quote-author-name">@Quote.InstructorName</div>
            <div class="quote-author-title">@Quote.InstructorTitle</div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public QuoteDto Quote { get; set; } = null!;
}
