@using Evaluate.Application.Dashboard

<div class="card">
    <h3 class="card-title">Latest Submissions</h3>
    <div class="table-scroll">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Ref</th>
                    <th>Student</th>
                    <th>Status</th>
                    <th>Score</th>
                    <th>Date</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Rows)
                {
                    <tr>
                        <td>#@row.ReferenceCode</td>
                        <td>
                            <div class="row-person">
                                <div class="avatar">@row.Initials</div>
                                <div>
                                    <div class="row-person-name">@row.StudentName</div>
                                    <div class="row-person-sub">@row.Subject</div>
                                </div>
                            </div>
                        </td>
                        <td><span class="status-pill pill-@row.StatusColor">@row.StatusText</span></td>
                        <td>@row.Score</td>
                        <td>@row.Date</td>
                        <td><button type="button" class="btn-edit">Edit</button></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<SubmissionRowDto> Rows { get; set; } = [];
}
