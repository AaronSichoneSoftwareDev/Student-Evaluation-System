@using Evaluate.Application.Dashboard

<div class="card">
    <h3 class="card-title">Inbox</h3>
    <div class="inbox-list">
        @foreach (var message in Messages)
        {
            <div class="inbox-item">
                <div class="avatar">@message.Initials</div>
                <div class="inbox-item-body">
                    <div class="inbox-item-name">@message.SenderName</div>
                    <div class="inbox-item-preview">@message.Preview</div>
                </div>
                <div class="inbox-item-time">@message.Time</div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<InboxMessageDto> Messages { get; set; } = [];
}
