@typeparam TItem

<div class="card">
    <div class="table-toolbar">
        @if (Tabs is { Count: > 0 })
        {
            <div class="table-tabs">
                @foreach (var tab in Tabs)
                {
                    var count = tab.Predicate is null ? Items.Count : Items.Count(tab.Predicate);
                    <button type="button" class="table-tab @(tab.Key == _activeTab ? "active" : "")" @onclick="() => SetTab(tab.Key)">
                        @tab.Label <span class="tab-count">@count</span>
                    </button>
                }
            </div>
        }
        else
        {
            <h3 class="card-title" style="margin-bottom:0;">@Title</h3>
        }

        @if (SearchPredicate is not null)
        {
            <div class="table-search">
                <i class="bi bi-search"></i>
                <input type="search" placeholder="@SearchPlaceholder" value="@_searchText" @oninput="OnSearchInput" />
            </div>
        }
    </div>

    @ChildContent(PagedItems)

    @if (TotalPages > 1)
    {
        <div class="table-pagination">
            <span class="table-pagination-info">Showing @FirstItemIndex&ndash;@LastItemIndex of @SortedItems.Count</span>
            <div class="table-pagination-controls">
                @if (EffectivePage > 1)
                {
                    <button type="button" class="page-btn" title="First page" @onclick="() => GoToPage(1)">
                        <i class="bi bi-chevron-double-left"></i>
                    </button>
                }
                <button type="button" class="page-btn" disabled="@(EffectivePage == 1)" @onclick="() => GoToPage(EffectivePage - 1)">
                    <i class="bi bi-chevron-left"></i>
                </button>
                @foreach (var pageNumber in PageNumbers)
                {
                    <button type="button" class="page-btn @(pageNumber == EffectivePage ? "active" : "")" @onclick="() => GoToPage(pageNumber)">@pageNumber</button>
                }
                <button type="button" class="page-btn" disabled="@(EffectivePage == TotalPages)" @onclick="() => GoToPage(EffectivePage + 1)">
                    <i class="bi bi-chevron-right"></i>
                </button>
                @if (EffectivePage < TotalPages)
                {
                    <button type="button" class="page-btn" title="Last page" @onclick="() => GoToPage(TotalPages)">
                        <i class="bi bi-chevron-double-right"></i>
                    </button>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<TItem> Items { get; set; } = [];

    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public List<TableTab<TItem>>? Tabs { get; set; }

    [Parameter]
    public Func<TItem, string, bool>? SearchPredicate { get; set; }

    [Parameter]
    public string SearchPlaceholder { get; set; } = "Search...";

    /// <summary>Pre-fills the search box — e.g. from a query string parameter carried over from
    /// the topbar search — without needing the caller to reach into this component's state.</summary>
    [Parameter]
    public string? InitialSearchTerm { get; set; }

    /// <summary>Applied after tab/search filtering and before pagination. Pass the page's own
    /// column-sort function here instead of sorting inside <see cref="ChildContent"/> — sorting
    /// after paging would only reorder whichever page happens to be showing.</summary>
    [Parameter]
    public Func<IReadOnlyList<TItem>, IReadOnlyList<TItem>>? Sort { get; set; }

    [Parameter]
    public int PageSize { get; set; } = 10;

    [Parameter, EditorRequired]
    public RenderFragment<IReadOnlyList<TItem>> ChildContent { get; set; } = default!;

    private string _activeTab = "all";
    private string _searchText = string.Empty;
    private int _currentPage = 1;

    protected override void OnInitialized()
    {
        if (!string.IsNullOrWhiteSpace(InitialSearchTerm))
        {
            _searchText = InitialSearchTerm;
        }
    }

    private IReadOnlyList<TItem> FilteredItems
    {
        get
        {
            IEnumerable<TItem> result = Items;

            var activeTabDefinition = Tabs?.FirstOrDefault(t => t.Key == _activeTab);
            if (activeTabDefinition?.Predicate is not null)
            {
                result = result.Where(activeTabDefinition.Predicate);
            }

            if (!string.IsNullOrWhiteSpace(_searchText) && SearchPredicate is not null)
            {
                result = result.Where(item => SearchPredicate(item, _searchText));
            }

            return result.ToList();
        }
    }

    private IReadOnlyList<TItem> SortedItems => Sort is null ? FilteredItems : Sort(FilteredItems);

    private int TotalPages => SortedItems.Count == 0 ? 1 : (int)Math.Ceiling(SortedItems.Count / (double)PageSize);

    /// <summary>Clamped read of <see cref="_currentPage"/> — the stored page can fall out of
    /// range after a filter/search shrinks the result set, without needing a mutating getter.</summary>
    private int EffectivePage => Math.Clamp(_currentPage, 1, TotalPages);

    private IReadOnlyList<TItem> PagedItems => SortedItems.Skip((EffectivePage - 1) * PageSize).Take(PageSize).ToList();

    private int FirstItemIndex => SortedItems.Count == 0 ? 0 : ((EffectivePage - 1) * PageSize) + 1;

    private int LastItemIndex => Math.Min(EffectivePage * PageSize, SortedItems.Count);

    /// <summary>Number of page buttons shown at once — beyond this, older page numbers slide
    /// out of view as the current page advances, rather than listing every page at once
    /// (which reads as unprofessional once a table has more than a handful of pages).</summary>
    private const int PageWindowSize = 5;

    private IEnumerable<int> PageNumbers
    {
        get
        {
            if (TotalPages <= PageWindowSize)
            {
                return Enumerable.Range(1, TotalPages);
            }

            var start = Math.Clamp(EffectivePage - (PageWindowSize / 2), 1, TotalPages - PageWindowSize + 1);
            return Enumerable.Range(start, PageWindowSize);
        }
    }

    private void SetTab(string key)
    {
        _activeTab = key;
        _currentPage = 1;
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchText = e.Value?.ToString() ?? string.Empty;
        _currentPage = 1;
    }

    private void GoToPage(int page) => _currentPage = Math.Clamp(page, 1, TotalPages);
}
